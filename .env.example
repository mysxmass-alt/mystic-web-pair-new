# Required for WhatsApp ownership and optional integrations
OWNER_NUMBER=2349036021563

# Optional Telegram bridge; leave empty to disable Telegram safely
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Optional Telegram membership gate; the bot must be an admin in each target chat.
TELEGRAM_FORCE_JOIN_ENABLED=true
TELEGRAM_FORCE_JOIN_TARGETS=-1003901471731,-1003833337043
TELEGRAM_FORCE_JOIN_CHANNEL_URL=https://t.me/mysdomain
TELEGRAM_FORCE_JOIN_GROUP_URL=https://t.me/mysticdomainx1
# Akari Telegram companion settings. In groups she replies when mentioned, replied to, or addressed by name.
AKARI_GROUP_REPLIES=true
# Comma-separated Telegram sticker file_ids or public sticker URLs; leave empty to disable automatic expressions.
AKARI_TELEGRAM_STICKER_IDS=
AKARI_STICKER_COOLDOWN_MS=45000
# Group moderation: delete links from non-admin messages and keep Akari replies attached to the original message.
TELEGRAM_ANTILINK_ENABLED=true
TELEGRAM_QUOTE_REPLIES=true
# Optional WhatsApp membership gate; verification uses WhatsApp group JIDs.
WHATSAPP_FORCE_JOIN_ENABLED=true
WHATSAPP_FORCE_JOIN_GROUP_IDS=120363409257777442@g.us
WHATSAPP_FORCE_JOIN_GROUP_LINK=https://chat.whatsapp.com/CUCycMI1xmMI6PCcqzEKtk?s=cl&p=a&ilr=1
WHATSAPP_FORCE_JOIN_OWNER_BYPASS=false
# Comma-separated admin phone numbers that bypass WhatsApp membership checks.
# Use international digits only, without a plus sign; JIDs are also normalized.
WHATSAPP_FORCE_JOIN_ADMIN_BYPASS_LIST=2348012345678,2348098765432
WHATSAPP_FORCE_JOIN_CHANNEL_LINK=

# Protected admin console — use a strong unique value; never commit the real password
ADMIN_PASSWORD=replace-with-a-long-random-secret

# Optional dashboard and panel settings
PORT=3000
BOT_PREFIX=.
PTERO_DOMAIN=
PTERO_PLTA=
